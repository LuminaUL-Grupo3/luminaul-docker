# ==============================================================================
# LuminaUL - Variables de Entorno de Producción (.env)
# ==============================================================================
# Copia este archivo a `.env` en el servidor y configura las credenciales reales:
#   cp .env.production.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Contenedor: luminaul-postgres)
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=CambiarPorPasswordSeguraDeProduccion2026!
DB_NAME=luminaul
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. Seguridad y Sesión JWT (SPEC-01)
# ------------------------------------------------------------------------------
# Secreto HS256 obligatorio en producción (mínimo 32 caracteres aleatorios).
# Puedes generar uno seguro en Linux/WSL con: openssl rand -base64 48
JWT_SECRET=CambiarPorClaveSecretaLargaYAleatoriaDeAlMenos32Caracteres2026!

# Tiempo de expiración de access token en segundos (86400 = 24 horas)
JWT_EXPIRES_IN=86400

# ------------------------------------------------------------------------------
# 3. Dominio DuckDNS, CORS y WebSockets (Gateway Socket.IO)
# ------------------------------------------------------------------------------
# Subdominio público configurado en https://www.duckdns.org
DOMAIN=luminaul.duckdns.org
DUCKDNS_SUBDOMAIN=luminaul
DUCKDNS_TOKEN=tu-token-alfanumerico-de-duckdns

# Lista de orígenes autorizados para CORS y WebSockets (incluye tu subdominio DuckDNS):
WEB_ORIGIN=https://luminaul.duckdns.org,http://luminaul.duckdns.org,http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1

# ------------------------------------------------------------------------------
# 4. Servicio de Correo Electrónico (SPEC-01: Códigos OTP de verificación / recuperación)
# ------------------------------------------------------------------------------
# Modo de transporte:
#   - console: Imprime los códigos de verificación en los logs del contenedor (ideal para pruebas y laboratorios)
#   - smtp:    Envía correos electrónicos reales a los estudiantes vía SMTP (producción real)
MAIL_TRANSPORT=console

# Configuración obligatoria cuando MAIL_TRANSPORT=smtp:
SMTP_HOST=smtp.gmail.com
# Puerto SMTP: 587 para STARTTLS (SMTP_SECURE=false) | 465 para SSL/TLS directo (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=soporte@luminaul.pe
SMTP_PASSWORD=contraseña-de-aplicación-o-api-key
MAIL_FROM="LuminaUL Soporte <soporte@luminaul.pe>"

# ------------------------------------------------------------------------------
# 5. Moderación Semántica con Inteligencia Artificial (SPEC-06 - Opcional)
# ------------------------------------------------------------------------------
# Clave de OpenAI para la moderación semántica en segundo plano.
# Si se deja vacía o no se define, el backend opera en modo tolerante (fail-safe)
# degradando automáticamente al filtro léxico de palabras prohibidas en PostgreSQL.
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 6. Control de Versiones para Despliegue Remoto (luminaul-docker)
# ------------------------------------------------------------------------------
# Ramas o tags de Git que Docker BuildKit clonará al construir las imágenes:
BACKEND_BRANCH=main
FRONTEND_BRANCH=main
